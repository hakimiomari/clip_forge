# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://clipforge:clipforge@localhost:5432/clipforge?schema=public

# ── Redis (BullMQ queues) ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API server ────────────────────────────────────────────
API_PORT=4000
# Origin allowed to call the API with credentials (the Next.js app)
WEB_ORIGIN=http://localhost:3000
# Set to "production" in prod — controls secure cookies etc.
NODE_ENV=development

# ── Auth ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ── Object storage (S3 compatible — MinIO in dev) ─────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=clipforge
S3_SECRET_KEY=clipforge-secret
S3_BUCKET=clipforge
# Public endpoint the *browser* uses for presigned URLs (same as S3_ENDPOINT in dev)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ── AI providers ──────────────────────────────────────────
# Highlight selection: anthropic | openai | heuristic
#  - "heuristic" needs no API key: signal-based selection (audio energy,
#    silences, scene cuts). Set anthropic/openai + AI_API_KEY for
#    LLM-quality selection with titles/hooks from the transcript.
AI_PROVIDER=heuristic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Transcription (needed for captions): openai | deepgram | none
#  - "none" disables captions; everything else still works.
TRANSCRIPTION_PROVIDER=none
TRANSCRIPTION_API_KEY=

# ── Video tooling ─────────────────────────────────────────
# Leave empty to use ffmpeg/ffprobe from PATH
FFMPEG_PATH=
FFPROBE_PATH=

# ── Optional: richer YouTube metadata (oEmbed used otherwise)
YOUTUBE_API_KEY=

# ── Frontend ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
